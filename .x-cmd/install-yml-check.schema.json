            "sensitive": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "Runtime": {
      "additionalProperties": false,
      "description": "behavior.runtime \u2014 type is either a string or array of strings",
      "properties": {
        "type": {
          "anyOf": [
