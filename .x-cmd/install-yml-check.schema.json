        },
        "peak": {
          "$ref": "#/definitions/CPUSubblock"
        }
      },
      "required": [
        "workload",
        "processes"
      ],
      "type": "object"
    },
    "Resource": {
      "additionalProperties": false,
      "description": "Resource block \u2014 disk + memory + cpu",
      "properties": {
        "disk": {
          "$ref": "#/definitions/Disk"
        },
        "memory": {
          "$ref": "#/definitions/Memory"
        },
        "cpu": {
          "$ref": "#/definitions/CPU"
        }
