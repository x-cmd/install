            },
            "linux": {
              "enum": [
                "full",
                "partial",
                "none"
              ],
              "type": "string"
            },
            "darwin": {
              "enum": [
                "full",
                "partial",
                "none"
              ],
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "behavior",
        "resource"
      ],
      "type": "object"
    },
    "InstallMeta": {
      "additionalProperties": false,
      "description": "`xw gen-schema` generate json schema\n\nfrom 'x-cmd-install/x-cmd-install' repo",
      "properties": {
        "binlist": {
          "description": "\u8f6f\u4ef6\u5305\u63d0\u4f9b\u7684\u547d\u4ee4",
