            ]
          },
          "description": "\u4e0b\u8f7d\u89c4\u5219\uff0ckey \u4e3a\u5bf9\u5e94\u7684\u5305\u7ba1\u7406\u5de5\u5177",
          "type": "object"
        },
        "source": {
          "description": "\u6e90\u7801 URL",
          "type": "string"
        },
        "x": {
          "additionalProperties": false,
          "description": "Cross-platform package-manager shortcuts. Each value must match the general package-name pattern ^[A-Za-z0-9@][A-Za-z0-9_.@/+:\\-#\\[\\]~?]{0,255}$ \u2014 strict enough to reject garbage (`--cask`, `&&`, `.`) but permissive enough for any legitimate package name (scoped npm, brew taps, Gentoo categories, nix attrs, go URLs). The value is the package name (or '1' as a placeholder for downloaders that don't have a package concept). Use the generic key (apt, dnf, brew, ...) when one installation works across all derivatives of that OS family. Only add specific overrides (kali/apt, ubuntu/apt, ...) when the install genuinely differs.",
