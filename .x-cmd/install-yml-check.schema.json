      "type": "object"
    },
    "Filesystem": {
      "additionalProperties": false,
      "description": "behavior.filesystem block \u2014 what the binary reads/writes",
      "properties": {
        "read": {
          "additionalProperties": false,
          "properties": {
            "desc": {
              "$ref": "#/definitions/I18nDescription"
            },
            "sensitive": {
              "items": {
                "type": "string"
