            "pkg": {
              "additionalProperties": false,
              "properties": {
                "exist": {
                  "type": "boolean"
                }
              },
              "required": [
                "exist"
              ],
              "type": "object"
            },
            "source": {
              "type": "string",
              "pattern": "^https?://[^\\s]+$"
            },
            "eget": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,127}/[A-Za-z0-9][A-Za-z0-9_.+-]{0,127}$"
            },
            "x": {
              "type": "string",
              "pattern": "^[A-Za-z0-9@][A-Za-z0-9_.@/+:\\-#\\[\\]~?]{0,255}$"
            },
            "x-cmd": {
              "type": "string",
              "pattern": "^[A-Za-z0-9@][A-Za-z0-9_.@/+:\\-#\\[\\]~?]{0,255}$"
            },
            "apt": {
