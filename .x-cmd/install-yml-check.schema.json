    "I18nDescription": {
      "additionalProperties": false,
      "properties": {
        "cn": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      },
      "required": [
        "en",
        "cn"
      ],
      "type": "object"
    },
    "ListenEnum": {
      "description": "Single-value enum for behavior.network.listen",
      "enum": [
        "none",
        "localhost",
        "lan",
        "internet"
      ],
      "type": "string"
    },
    "Connect": {
      "additionalProperties": false,
      "description": "Independent flags for each outbound destination",
      "properties": {
        "localhost": {
          "type": "boolean"
        },
        "lan": {
          "type": "boolean"
        },
        "internet": {
          "type": "boolean"
        }
      },
      "required": [
        "localhost",
        "lan",
        "internet"
      ],
      "type": "object"
    },
    "Network": {
      "additionalProperties": false,
      "description": "Network permissions \u2014 direction (listen/connect) x surface (localhost/lan/internet)",
      "properties": {
        "listen": {
          "$ref": "#/definitions/ListenEnum"
        },
        "connect": {
          "$ref": "#/definitions/Connect"
        }
      },
      "required": [
        "listen",
        "connect"
      ],
      "type": "object"
    },
    "Estimate": {
      "description": "Size estimate \u2014 human-readable string with unit. Allowed units: B, KB, MB, GB (and lowercase). Examples: '12 MB', '2.5 GB', '500 KB', '65 B'.",
      "type": "string",
      "pattern": "^[\\d.]+\\s+(B|KB|MB|GB|[KMG]B?)$"
    },
    "Rating1to5": {
      "description": "0..5 rating (0 = idle/none, 1..5 = active \u2014 see rating.md \u00a7 4)",
      "enum": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "type": "integer"
    },
    "DiskSize": {
      "additionalProperties": false,
      "description": "Disk size block \u2014 estimate + (rating only for install) + i18n desc",
      "properties": {
        "estimate": {
          "$ref": "#/definitions/Estimate"
        },
        "rating": {
          "$ref": "#/definitions/Rating1to5"
        },
        "desc": {
          "$ref": "#/definitions/I18nDescription"
        }
      },
      "required": [
        "estimate"
      ],
      "type": "object"
    },
    "Disk": {
      "additionalProperties": false,
      "description": "Resource disk block \u2014 install/download sizes + paths + growth",
      "properties": {
        "size": {
          "additionalProperties": false,
          "properties": {
            "install": {
              "$ref": "#/definitions/DiskSize"
            },
            "download": {
              "$ref": "#/definitions/DiskSize"
            },
            "growth": {
              "additionalProperties": false,
              "properties": {
                "desc": {
                  "$ref": "#/definitions/I18nDescription"
                }
              },
              "required": [
                "desc"
              ],
              "type": "object"
            }
          },
          "required": [
            "install"
          ],
          "type": "object"
        },
        "paths": {
          "additionalProperties": false,
          "properties": {
            "data": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "config": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "cache": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "size"
      ],
      "type": "object"
    },
    "Memory": {
      "additionalProperties": false,
      "description": "Resource memory block \u2014 idle (and optional peak)",
