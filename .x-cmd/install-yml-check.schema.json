              "items": {
                "enum": [
                  "cli",
                  "tui",
                  "gui",
                  "daemon",
                  "server",
                  "lib",
                  "library",
                  "plugin",
                  "interactive",
                  "oneshot",
                  "script",
                  "wrapper"
