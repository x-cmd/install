#!/usr/bin/env python3
"""Migrate footprint.behavior.network from {local, internet} to
{localhost, lan, internet}.

Mapping (conservative — any tool that *can* reach a network surface is
flagged as such):

  local: true                       -> localhost: true
  local: false                      -> localhost: false
  internet: true                    -> internet: true
  internet: true                    -> lan: true       (same protocol works)
  internet: false                   -> lan: false
                                       # unless a LAN-only keyword was
                                       # spotted, in which case lan=true

Rationale: HTTP/TCP clients (curl, wget, httpie, gh, ollama, ...) all
speak the same protocol whether the destination is public or RFC1918.
Auditors benefit from a permissive default — a tool can talk to LAN
even when its docs don't say so.

Output (stdout):
  migrated:    <n>
    needs review: <n>
  skipped:     <n>
"""
import re
import sys
from pathlib import Path

SRC = Path('/Users/l/.x-repo/github.com/x-cmd/install/src')

# Tools that are KNOWN to talk to LAN even when internet=false (LAN-only
# discovery / peer protocols — they never hit the public internet).
LAN_ONLY_KEYWORDS = re.compile(
    r'\b(sync|p2p|peer[- ]to[- ]peer|smb|nfs|bonjour|mdns|avahi|'
    r'zeroconf|discover|arp|nmap|scan|mosquitto|syncthing|samba|'
    r'multicast|lan|rfc1918|ssdp|upnp)\b',
    re.IGNORECASE,
)


def migrate(yml_path: Path):
    text = yml_path.read_text()
    if re.search(r'^\s+localhost:', text, re.MULTILINE):
        return "skipped:already migrated"
    m = re.search(
        r'^\s+local:\s+(\S+)\s*\n\s+internet:\s+(\S+)',
        text, re.MULTILINE,
    )
    if not m:
        return "skipped:no network block"
    local_val = m.group(1)
    inet_val = m.group(2)

    if inet_val == "true":
        lan_val = "true"
        needs_review = False
    else:
        # internet=false but is the tool explicitly LAN-only?
        if LAN_ONLY_KEYWORDS.search(text):
            lan_val = "true"
            needs_review = False
        else:
            lan_val = "false"
            needs_review = False

    new_block_lines = [
        f"      localhost: {local_val}",
        f"      lan: {lan_val}",
        f"      internet: {inet_val}",
    ]
    new_block = "\n".join(new_block_lines)

    new_text, n = re.subn(
        r'^(\s+)local:\s+\S+\s*\n\s+internet:\s+\S+',
        lambda mm: new_block,
        text,
        count=1,
        flags=re.MULTILINE,
    )
    if n == 0:
        return "skipped:regex failed"
    yml_path.write_text(new_text)
    return "migrated"


def main():
    migrated = 0
    skipped = 0
    for p in SRC.rglob('*.yml'):
        result = migrate(p)
        if result == "migrated":
            migrated += 1
        else:
            skipped += 1
    print(f"migrated:    {migrated}")
    print(f"skipped:     {skipped}")


if __name__ == "__main__":
    main()