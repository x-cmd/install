"""Migrate footprint.behavior.network schemas.

Phase 1 (already shipped): {local, internet} -> {localhost, lan, internet}
Phase 2 (this script):    {localhost, lan, internet} -> {listen, connect}

Final schema:
  network:
    listen:    none | localhost | lan | internet   # single enum
    connect:                                 # independent flags
      localhost: true|false
      lan:       true|false
      internet:  true|false

By default the migration only writes files still on the {localhost, lan,
internet} triple (phase 1 output). With --force it also rewrites files
already in the {listen, connect} shape, recomputing the values with the
new heuristic defaults.
"""
import re
import sys
from pathlib import Path

SRC = Path('/Users/l/.x-repo/github.com/x-cmd/install/src')

# Keywords that imply LAN-only behavior (talk to RFC1918 peers even
# without hitting the public internet).
LAN_ONLY_KEYWORDS = re.compile(
    r'\b(sync|p2p|peer[- ]to[- ]peer|smb|nfs|bonjour|mdns|avahi|'
    r'zeroconf|discover|arp|nmap|scan|mosquitto|syncthing|samba|'
    r'multicast|rfc1918|ssdp|upnp)\b',
    re.IGNORECASE,
)

# Keywords that imply the binary BINDS something (server / broker /
# daemon / listener). Bump `listen` above `none` only when these match.
LISTEN_KEYWORDS = re.compile(
    r'\b(server|daemon|broker|listen|bind|socket|proxy|tunnel|'
    r'mosquitto|syncthing|ngrok|sshd|nfsd|smbd)\b',
    re.IGNORECASE,
)


def strip_network_block(text):
    return re.sub(
        r'^[ \t]+(localhost|lan|internet|listen|connect):.*',
        '',
        text,
        flags=re.MULTILINE,
    )


def derive_listen(text):
    """Default `none`. Bump up only with LISTEN_KEYWORDS."""
    if LISTEN_KEYWORDS.search(strip_network_block(text)):
        return "localhost"
    return "none"


def derive_connect(text):
    """Conservative defaults: localhost: false; lan: false; internet: false.
    LAN-keyword override sets lan: true. Public-internet markers (which
    only exist in the original `internet: true` legacy schema — not in
    the new shape) are no longer relevant here."""
    if LAN_ONLY_KEYWORDS.search(strip_network_block(text)):
        return False, True, False
    return False, False, False


# Match either:
#   (a) phase-1 shape: localhost: <b>\n lan: <b>\n internet: <b>
#   (b) phase-2 shape: listen: <x>\n connect:\n   localhost: <b>\n   lan: <b>\n   internet: <b>
# Both should be replaced with the new listen/connect block at the
# SAME outer indent as the first matched line.

TRIPLE_RE = re.compile(
    r'^([ \t]+)(?:listen:\s+\S+[ \t]*\n'
    r'\1connect:[ \t]*\n)?'
    r'(?:[ \t]+)?localhost:\s+(true|false)[ \t]*\n'
    r'\1[ \t]*lan:\s+(true|false)[ \t]*\n'
    r'\1[ \t]*internet:\s+(true|false)[ \t]*\n',
    re.MULTILINE,
)


def phase2_migrate(yml_path: Path, force=False):
    text = yml_path.read_text()
    if not force and not TRIPLE_RE.search(text):
        return "skipped:no triple block"

    def repl(m):
        indent = m.group(1)
        listen_val = derive_listen(text)
        lo, lan, inet = derive_connect(text)
        return (
            f"{indent}listen: {listen_val}\n"
            f"{indent}connect:\n"
            f"{indent}  localhost: {'true' if lo else 'false'}\n"
            f"{indent}  lan: {'true' if lan else 'false'}\n"
            f"{indent}  internet: {'true' if inet else 'false'}\n"
        )

    new_text, n = TRIPLE_RE.subn(repl, text)
    if n == 0:
        return "skipped:regex failed"
    yml_path.write_text(new_text)
    return "migrated"


def main():
    force = "--force" in sys.argv
    migrated = 0
    skipped = 0
    for p in SRC.rglob('*.yml'):
        result = phase2_migrate(p, force=force)
        if result == "migrated":
            migrated += 1
        else:
            skipped += 1
    print(f"phase 2 migrated:  {migrated}")
    print(f"skipped:           {skipped}")


if __name__ == "__main__":
    main()