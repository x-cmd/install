#!/usr/bin/env python3
"""Auto-populate x: package-manager shortcuts from rule: block.

Adds common package managers and language ecosystems to the x: shortcut
keys. Generic keys only — specific overrides (kali/apt, ubuntu/brew, ...)
are intentionally NOT added.

Generic keys:
  Linux package managers: apt, apt-get, dnf, yum, zypper, pacman, apk,
                          brew, snap, port, emerge, xbps, pkg, eopkg,
                          scoop, choco, winget, flatpak, nix, guix, kiss,
                          pacstall, deb-get, makepkg, trizen, aura,
                          yay, paru, pacaur, pikaur, yaourt
  Language ecosystems:    pip, npm, gem, cargo, go
  Version managers:       asdf, pixi
  Download methods:       curl, wget, fetch, git, make, build

Behavior:
  - rule: block is NEVER touched
  - If x: block already exists: append missing shortcuts
  - If x: block does NOT exist: create one right after the rule: block
  - @-prefixed values (e.g. npm scoped packages) are auto-quoted
"""
import re
from pathlib import Path

SRC = Path('/Users/l/.x-repo/github.com/x-cmd/install/src')

# (x-key,  cmd regex with one pkg capture)
# \w* suffix on flags covers -Syu, -Sy, -S --needed, etc.
GENERIC_RULES = [
    # Linux package managers
    ('apt',       re.compile(r'\bapt(?:-get)?\s+install\s+(\S+)')),
    ('apt-get',   re.compile(r'\bapt-get\s+install\s+(\S+)')),
    ('dnf',       re.compile(r'\b(?:dnf|yum)\s+install\s+(\S+)')),
    ('yum',       re.compile(r'\byum\s+install\s+(\S+)')),
    ('zypper',    re.compile(r'\bzypper\s+(?:--non-interactive\s+)?in(?:stall)?\s+(\S+)')),
    ('pacman',    re.compile(r'\bpacman\s+-S\s+(\S+)')),
    ('apk',       re.compile(r'\bapk\s+add\s+(?:--no-cache\s+)?(\S+)')),
    ('port',      re.compile(r'\bport\s+install\s+(\S+)')),
    ('emerge',    re.compile(r'\bemerge\s+(?:--ask\s+)?(\S+)')),
    ('xbps',      re.compile(r'\bxbps-install\s+(?:-S\s+)?(\S+)')),
    ('pkg',       re.compile(r'\bpkg\s+(?:install|add)\s+(\S+)')),
    ('eopkg',     re.compile(r'\beopkg\s+install\s+(\S+)')),
    ('scoop',     re.compile(r'\bscoop\s+install\s+(\S+)')),
    ('choco',     re.compile(r'\bchoco\s+install\s+(?:-y\s+)?(\S+)')),
    ('winget',    re.compile(r'\bwinget\s+install\s+(?:--id\s+)?(\S+)')),
    ('powershell',re.compile(r'\b(?:Install-Module|choco\s+install|winget)\s+.*?(\S+)')),
    ('brew',      re.compile(r'\bbrew\s+install\s+(\S+)')),
    ('snap',      re.compile(r'\bsnap\s+install\s+(\S+)')),
    ('flatpak',   re.compile(r'\bflatpak\s+install\s+(?:-y\s+)?(\S+)')),
    ('nix',       re.compile(r'\bnix(?:-env|-shell|-profile)?\s+(?:profile\s+)?install\s+(\S+)')),
    ('guix',      re.compile(r'\bguix\s+package\s+(?:-i\s+)?(\S+)')),
    ('kiss',      re.compile(r'\bkiss\s+install\s+(\S+)')),
    ('pacstall',  re.compile(r'\bpacstall\s+-I\s+(\S+)')),
    ('deb-get',   re.compile(r'\bdeb-get\s+install\s+(\S+)')),
    ('makepkg',   re.compile(r'\bmakepkg\s+-si\b')),
    ('trizen',    re.compile(r'\btrizen\s+-S\s+(\S+)')),
    ('aura',      re.compile(r'\baura\s+-A\s+(\S+)')),
    ('yay',       re.compile(r'\byay\s+-S\s+(\S+)')),
    ('paru',      re.compile(r'\bparu\s+-S\s+(\S+)')),
    ('pacaur',    re.compile(r'\bpacaur\s+-S\s+(\S+)')),
    ('pikaur',    re.compile(r'\bpikaur\s+-S\s+(\S+)')),
    ('yaourt',    re.compile(r'\byaourt\s+-S\s+(\S+)')),
    # Language ecosystems
    ('pip',       re.compile(r'\bpip(?:3)?\s+install\s+(\S+)')),
    ('npm',       re.compile(r'\bnpm\s+install\s+(?:-g\s+)?(\S+)')),
    ('gem',       re.compile(r'\bgem\s+install\s+(\S+)')),
    ('cargo',     re.compile(r'\bcargo\s+install\s+(\S+)')),
    ('go',        re.compile(r'\bgo\s+install\s+(\S+)')),
    # Version managers
    ('asdf',      re.compile(r'\basdf\s+(?:plugin\s+add\s+)?\S+')),
    ('pixi',      re.compile(r'\bpixi\s+(?:add|install)\s+(\S+)')),
    # Downloaders (no pkg capture; key itself is the value)
    ('curl',      re.compile(r'\bcurl\s+(?:-[A-Za-z]+\s+)*https?://')),
    ('wget',      re.compile(r'\bwget\s+(?:-[A-Za-z]+\s+)*https?://')),
    ('fetch',     re.compile(r'\bfetch\s+(?:-[A-Za-z]+\s+)*https?://')),
    ('git',       re.compile(r'\bgit\s+clone\s+(\S+)')),
    ('make',      re.compile(r'\bmake\s+install\b')),
    ('build',     re.compile(r'\b(?:go|cmake|cargo|meson)\s+build\b')),
    ('eget',      re.compile(r'\bx\s+eget\s+(\S+)')),
]


def extract_rule_block(text):
    m = re.search(r'^rule:\s*\n', text, re.MULTILINE)
    if not m:
        return None, None
    start = m.end()
    nxt = re.search(r'^[a-z][a-z_/]*:\s*(\S|$)', text[start:], re.MULTILINE)
    end = start + (nxt.start() if nxt else len(text) - start)
    return start, end


def find_x_block(text):
    m = re.search(r'^x:\s*\n', text, re.MULTILINE)
    if not m:
        return None, None
    start = m.start()
    pos = m.end()
    while pos < len(text):
        nxt = re.search(r'^[a-z][a-z_/]*:\s*(\S|$)', text[pos:], re.MULTILINE)
        if not nxt:
            return start, len(text)
        next_line_start = pos + nxt.start()
        if text[next_line_start] != ' ' and text[next_line_start] != '\t':
            return start, next_line_start
        pos = text.find('\n', next_line_start) + 1
    return start, len(text)


def existing_keys(x_block):
    keys = set()
    for m in re.finditer(r'^  ([a-z][\w/-]*):\s', x_block, re.MULTILINE):
        keys.add(m.group(1))
    return keys


def format_value(key, raw):
    """Quote values that start with @ (YAML 1.1 doesn't allow @ in plain
    scalars at start of value)."""
    if raw.startswith('@'):
        return f'"{raw}"'
    return raw


def fixup(yml_path: Path):
    text = yml_path.read_text()
    r_start, r_end = extract_rule_block(text)
    if r_start is None:
        return False
    rule_block = text[r_start:r_end]

    x_start, x_end = find_x_block(text)

    if x_start is None:
        existing = set()
    else:
        existing = existing_keys(text[x_start:x_end])

    # Collect missing shortcuts
    found = {}
    for key, rx in GENERIC_RULES:
        if key in existing:
            continue
        m = rx.search(rule_block)
        if m:
            found[key] = format_value(key, m.group(1) if m.lastindex else key)

    if not found:
        return False

    lines = '\n'.join(f'  {k}: {v}' for k, v in found.items())

    if x_start is None:
        new_block = f'\nx:\n{lines}\n'
        text = text[:r_end] + new_block + text[r_end:]
    else:
        stripped = text[x_start:x_end].rstrip('\n')
        new_x_block = stripped + '\n' + lines + '\n'
        text = text[:x_start] + new_x_block + text[x_end:]

    yml_path.write_text(text)
    return True


FIXED = 0
for p in SRC.rglob('*.yml'):
    if fixup(p):
        FIXED += 1
print(f"updated: {FIXED}")